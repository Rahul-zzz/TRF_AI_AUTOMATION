# Copy this file to .env and adjust as needed. Never commit the real .env.

# Path to the SQLite database file
DATABASE_PATH=data/tr_operations.db

# --- Alert thresholds (PROTOTYPE VALUES — validate with operations staff) ---
DAYS_AT_LOCATION_WARNING=3
DAYS_AT_LOCATION_HIGH=5
DAYS_AT_LOCATION_CRITICAL=8

DAYS_IN_TRANSIT_WARNING=5
DAYS_IN_TRANSIT_HIGH=8

UNLOADING_DELAY_HIGH=1
UNLOADING_DELAY_CRITICAL=4

TRACKING_INACTIVITY_WARNING=2
TRACKING_INACTIVITY_CRITICAL=5

DUPLICATE_WINDOW_DAYS=1

